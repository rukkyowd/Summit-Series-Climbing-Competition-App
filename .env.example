# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use one public browser key only.
# Preferred: publishable key from Supabase API settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_browser_key

# Optional legacy alternative if your project still uses the anon JWT format.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_your_legacy_anon_key

# Judge/admin PIN for unlocking route controls in the UI
NEXT_PUBLIC_ADMIN_PIN=1234
