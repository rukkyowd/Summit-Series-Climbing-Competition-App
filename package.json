{
  "name": "climbing-comp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-no-exposed-secrets.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "security:secrets": "node scripts/check-no-exposed-secrets.mjs",
    "test": "vitest run",
    "db:push": "npx supabase db push --linked",
    "db:push:dry": "npx supabase db push --linked --dry-run",
    "db:pull": "npx supabase db pull",
    "db:migration:new": "npx supabase migration new"
  },
  "dependencies": {
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/analytics": "^2.0.1",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
